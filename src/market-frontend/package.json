    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "mcp": "ruler apply",
    "mcp:revert": "ruler revert"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.8",
    "@primeuix/themes": "^2.0.3",
    "@primevue/forms": "^4.5.4",
    "@vueuse/core": "^14.2.1",
    "chart.js": "^4.5.1",
    "flag-icons": "^7.5.0",
    "pinia": "^3.0.4",
    "plotly.js-dist": "^3.4.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.4",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@intellectronica/ruler": "^0.3.37",
    "@primevue/auto-import-resolver": "^4.5.4",
