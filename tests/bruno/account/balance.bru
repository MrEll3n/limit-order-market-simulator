meta {
  name: Balance (single product)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/account/balance?product={{product}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  ## Account Balance (single product)

  Returns the current balance and share balance for the authenticated user for a specific product.

  **Auth** — Bearer token required

  **Query parameters**
  | Param   | Type   | Required | Description             |
  |---------|--------|----------|-------------------------|
  | product | string | yes      | Product to query        |

  **Responses**
  - `200` — `{ balance, portfolioValue, products: { [product]: { postSellVolume, price, value } } }`
  - `400` — unknown product
  - `401` — not authenticated
}
