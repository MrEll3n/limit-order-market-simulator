meta {
  name: Balance (all products)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/account/balance
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  ## Account Balance (all products)

  Returns the current balance and share balances for all products for the authenticated user.

  **Auth** — Bearer token required

  **Query parameters**
  none

  **Responses**
  - `200` — `{ balance, portfolioValue, products: { [product]: { postSellVolume, price, value } } }`
  - `401` — not authenticated
}
