# Copy this file to .env and fill in your own values.
# .env is git-ignored and must NEVER be committed.
# REQUIRED values (marked below) must be set — the server will refuse to start without them.

# Secret for signing JWT access tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=replace-with-your-own-random-value

# Secret for Tornado secure cookies (legacy web handlers)
COOKIE_SECRET=replace-with-your-own-random-value

# Allowed CORS origin for the frontend
# Development:  http://localhost:3000
# Production:   https://your-domain.com
CORS_ORIGIN=http://localhost:3000

# Set to "true" when running behind HTTPS (marks cookies as Secure)
HTTPS=false

# Allowed email domains for registration (comma-separated)
ALLOWED_EMAIL_DOMAINS=students.zcu.cz,example.com

# Server host and ports
HOST=http://127.0.0.1
PORT=8888

# Admin account (created automatically on server start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-your-own-random-value

# Credentials for built-in bot accounts (stored hashed in the database)
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(24))"
BOT_PASSWORD=replace-with-your-own-random-value
MARKET_MAKER_EMAIL=market_maker
MARKET_MAKER_PASSWORD=replace-with-your-own-random-value
LIQUIDITY_GENERATOR_EMAIL=liquidity_generator
LIQUIDITY_GENERATOR_PASSWORD=replace-with-your-own-random-value
